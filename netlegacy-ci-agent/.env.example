# Local dev overrides. In-cluster these are injected by Helm/k8s instead.
AGENT_NAME=netlegacy-ci
AGENT_LOG_LEVEL=DEBUG

# GitHub token with 'repo' scope: required to push a branch and open the PR.
GITHUB_TOKEN=ghp_replace_me

# This worker is deterministic — no AGENT_MODEL / ANTHROPIC_API_KEY required.
