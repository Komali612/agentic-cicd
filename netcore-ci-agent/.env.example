# Local dev overrides — NON-SECRET only. In-cluster these come from Helm/k8s.
AGENT_NAME=netcore-ci
AGENT_LOG_LEVEL=DEBUG

# Secrets are NOT stored here. GITHUB_TOKEN comes from Doppler at launch:
#   doppler run -- python -m agent.main
# One-time setup is in ../SECRETS.md.
#
# This worker is deterministic — no AGENT_MODEL / ANTHROPIC_API_KEY required.
