# Local dev overrides. In-cluster these are injected by Helm/k8s instead.
AGENT_NAME=orchestrator
AGENT_LOG_LEVEL=DEBUG

# Worker agent URLs (in-cluster these default to the service names):
WORKER_NETCORE_CI_URL=http://localhost:8081
WORKER_NETLEGACY_CI_URL=http://localhost:8082

# GitHub token — optional for public repos, required for private repos/orgs.
GITHUB_TOKEN=ghp_replace_me

# Optional LLM-assisted classification (falls back to the heuristic without these):
# AGENT_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
