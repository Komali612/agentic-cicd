# Local dev overrides — NON-SECRET only. In-cluster these come from Helm/k8s.
AGENT_NAME=orchestrator
AGENT_LOG_LEVEL=DEBUG

# Worker agent URLs (in-cluster these default to the service names):
WORKER_NETCORE_CI_URL=http://localhost:8081
WORKER_NETLEGACY_CI_URL=http://localhost:8082

# Secrets are NOT stored here. GITHUB_TOKEN (and, if you enable LLM-assisted
# classification, ANTHROPIC_API_KEY) come from Doppler at launch:
#   doppler run -- python -m agent.main
# One-time setup is in ../SECRETS.md.
#
# Optional LLM-assisted classification (falls back to the heuristic without it):
# AGENT_MODEL=claude-opus-5
